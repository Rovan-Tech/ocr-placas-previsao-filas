# Copie para backend/.env para sobrescrever o padrão de app/config.py
DATABASE_URL=postgresql+psycopg://ocr:ocr@localhost:5433/ocr_placas
# Usado só pelo teste de migrações (tests/test_migrations.py)
TEST_DATABASE_URL=postgresql+psycopg://ocr:ocr@localhost:5433/ocr_placas_test

# Origem(ns) do frontend liberadas pelo CORS, separadas por vírgula. Vazio em
# dev local (o proxy do Vite dispensa CORS). Em produção, a URL pública do
# frontend (ex: https://ocr-placas.pages.dev).
FRONTEND_ORIGINS=
# Limite de requisições ao /ocr/upload por IP (proteção contra DoS).
OCR_UPLOAD_RATE_LIMIT=10/minute
