# Copie para backend/.env para sobrescrever o padrão de app/config.py
DATABASE_URL=postgresql+psycopg://ocr:ocr@localhost:5433/ocr_placas
# Usado só pelo teste de migrações (tests/test_migrations.py)
TEST_DATABASE_URL=postgresql+psycopg://ocr:ocr@localhost:5433/ocr_placas_test

# Assina os tokens de login. Comentado de propósito: uma linha JWT_SECRET_KEY= vazia sobrescreve
# a chave aleatória seria pior que não ter nada (chave vazia é adivinhável). Sem definir, o
# servidor gera uma chave aleatória a cada subida — todo mundo loga de novo a cada restart (ok
# pra rodar local; descomente e gere uma de verdade pra produção com: openssl rand -hex 32).
# JWT_SECRET_KEY=

# Pasta onde ficam as fotos de resguardo (câmera não leu, fiscal digitou por cima). Relativa a
# backend/, a não ser que um caminho absoluto seja informado.
UPLOAD_DIR=data/uploads
